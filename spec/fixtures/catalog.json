        "heading": {
          "type": "text"
        },
        "subheading": {
          "type": "textarea"
        },
        "imageUrl": {
          "type": "text",
          "label": "Background image URL"
        },
        "buttonLabel": {
          "type": "text",
          "label": "Button label"
        },
        "buttonHref": {
          "type": "text",
          "label": "Button link"
        }
      },
      "defaultProps": {
        "heading": "Welcome",
        "subheading": "",
        "imageUrl": "",
        "buttonLabel": "",
        "buttonHref": ""
