{
  "catalog": 1,
  "categories": {
    "church": "Church",
    "layout": "Layout",
    "content": "Content",
    "media": "Media"
  },
  "page": {
    "fields": {
      "title": {
        "type": "text",
        "label": "Page title (browser tab)"
      },
      "background": {
        "type": "radio",
        "label": "Background",
        "options": [
          {
            "label": "Site's",
            "value": "site"
          },
          {
            "label": "Custom",
            "value": "custom"
          },
          {
            "label": "None",
            "value": "none"
          }
        ]
      },
      "backgroundImage": {
        "type": "text",
        "label": "Custom background image URL"
      },
      "overlayColor": {
        "type": "text",
        "label": "Custom overlay color (hex)"
      },
      "overlayOpacity": {
        "type": "number",
        "label": "Overlay opacity % (blank uses the site setting)",
        "min": 0,
        "max": 100
      }
    },
    "defaultProps": {
      "title": "",
      "background": "site",
      "backgroundImage": "",
      "overlayColor": "#ffffff"
    }
  },
  "blocks": {
    "Section": {
      "label": "Section",
      "category": "layout",
      "fields": {
        "background": {
          "type": "select",
          "options": [
            {
              "label": "None",
              "value": "none"
            },
            {
              "label": "Muted",
              "value": "muted"
            },
            {
              "label": "Accent",
              "value": "accent"
            }
          ]
        },
        "backgroundImage": {
          "type": "text",
          "label": "Background image URL (optional)"
        },
        "overlayColor": {
          "type": "text",
          "label": "Overlay color over the image (hex, e.g. #ffffff)"
        },
        "overlayOpacity": {
          "type": "number",
          "label": "Overlay opacity %",
          "min": 0,
          "max": 100
        },
        "padding": {
          "type": "select",
          "options": [
            {
              "label": "none",
              "value": "none"
            },
            {
              "label": "small",
              "value": "small"
            },
            {
              "label": "medium",
              "value": "medium"
            },
            {
              "label": "large",
              "value": "large"
            }
          ]
        },
        "content": {
          "type": "slot"
        }
      },
      "defaultProps": {
        "background": "none",
        "backgroundImage": "",
        "overlayColor": "#ffffff",
        "overlayOpacity": 85,
        "padding": "medium"
      }
    },
    "Columns": {
      "label": "Columns",
      "category": "layout",
      "fields": {
        "count": {
          "type": "radio",
          "options": [
            {
              "label": "2",
              "value": 2
            },
            {
              "label": "3",
              "value": 3
            }
          ]
        },
        "first": {
          "type": "slot"
        },
        "second": {
          "type": "slot"
        },
        "third": {
          "type": "slot"
        }
      },
      "defaultProps": {
        "count": 2
      }
    },
    "Spacer": {
      "label": "Spacer",
      "category": "layout",
      "fields": {
        "size": {
          "type": "select",
          "options": [
            {
              "label": "small",
              "value": "small"
            },
            {
              "label": "medium",
              "value": "medium"
            },
            {
              "label": "large",
              "value": "large"
            }
          ]
        }
      },
      "defaultProps": {
        "size": "medium"
      }
    },
    "Divider": {
      "label": "Divider",
      "category": "layout",
      "fields": {},
      "defaultProps": {}
    },
